  m_Script: {fileID: 11500000, guid: fe8b4c4ac166645688cf003a1ef72207, type: 3}
  m_Name: Mission
  m_EditorClassIdentifier: Bayanihan::MissionDefinition
  title: "Pagbaha sa Barangay \xB7 The Water Rises"
  briefing: 'The creek jumped its banks before dawn. Families are on their roofs
    and clinging to the posts. Take everyone to the Barangay Hall at the west end:
    nobody is safe until the clerk has written their name.'
  setting: "Daytime \xB7 Flood"
  reports:
  - A cable is down at the second junction west. The water there is live, and only
    the Radyo can have the power cut.
  - 'Wreckage jams a side street to the north: whoever is behind it can only be reached
    by a line thrown over.'
  - The water is rising, about ten centimetres a minute.
  timeLimit: 480
  stormIntensity: 0.7
  waterRisePerMinute: 0.1
  maxWaterRise: 0.6
